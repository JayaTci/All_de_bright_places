# Copy to All_de_bright_placesFrontend/.env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
SITE_URL=http://127.0.0.1:3000
# Server-only mapping. These emails are not public usernames.
RUBY_AUTH_EMAIL=replace-ruby@example.invalid
JAYATCI_AUTH_EMAIL=replace-jayatci@example.invalid
# Only for local development with local Supabase CAPTCHA disabled.
ALLOW_LOCAL_CAPTCHA_BYPASS=false
# No Supabase administrative key or Groq key belongs in the app environment.
